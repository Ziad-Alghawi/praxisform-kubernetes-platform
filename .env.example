# Optional overrides for docker-compose.yml. Copy to .env to change them.
# All values here are fake demo values. Generate your own for anything shared.

# JWT signing key, at least 32 characters (e.g. openssl rand -base64 48)
JWT_SECRET=demo-only-jwt-secret-not-for-production-use

# Access token lifetime in minutes
JWT_EXP_MINUTES=120

# Password of the "admin" user, applied only when the database has no admin yet
ADMIN_DEFAULT_PASSWORD=demo-only-not-a-real-password
